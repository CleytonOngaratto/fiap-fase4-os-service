# Usado pelo docker-compose.yaml.

# Porta do Postgres exposta no HOST. Se a 5433 já estiver em uso por um
# Postgres local, troque aqui (ex.: 5434) — não afeta a app dentro do compose,
# que fala com o banco por `oficina_db:5432`.
DB_PORT_HOST=5433

# Credenciais do banco (dev local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=oficina_db

# Chave usada no hash de senha (lida por SecurityAdapter via System.getenv)
SECRET_KEY=oficina-secret-key-dev

# --- Fase 3 / F9: chave RSA do JWT ---
# O par nao fica mais no classpath. Antes do primeiro `docker compose up` / `quarkus:dev`:
#   mkdir -p secrets && cp ../.secrets/*.pem secrets/
# ./secrets/ e gitignored. Em producao vem do SSM para um Secret do k8s montado como volume.
# JWT_PUBLIC_KEY_LOCATION=file:./secrets/publicKey.pem
# JWT_PRIVATE_KEY_LOCATION=file:./secrets/privateKey.pem

# --- Fase 3 / Bloco 4b: agente Java do New Relic ---
# A chave é opcional (sem ela a app sobe igual) e NÃO entra aqui: já vive no SSM, e um .env seria
# uma terceira cópia para vazar. Injete só na sessão do shell:
#   $env:NEW_RELIC_LICENSE_KEY = (aws ssm get-parameter --name /fase4/newrelic/license-key `
#     --with-decryption --query Parameter.Value --output text --region us-east-1)
# O default `car-workshop-api-local` mantém o tráfego de dev fora do APM do Bloco 6.
# NEW_RELIC_APP_NAME=car-workshop-api-local

# --- Fase 3: datasource por env (espelha /fase4/rds/*) ---
# Os defaults do application.properties ja servem o dev local; o docker-compose preenche estes.
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=oficina_db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_SSLMODE=disable   # no RDS e `require` (rds.force_ssl = 1)
