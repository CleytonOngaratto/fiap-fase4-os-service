            {
              "name": "Cadastrar o cliente",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const digits = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                      "const checkDigit = (values) => {",
                      "  const sum = values.reduce((total, digit, index) => total + digit * (values.length + 1 - index), 0);",
                      "  const rest = sum % 11;",
                      "  return rest < 2 ? 0 : 11 - rest;",
                      "};",
                      "digits.push(checkDigit(digits));",
                      "digits.push(checkDigit(digits));",
                      "pm.environment.set('cpf', digits.join(''));"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('responde 201', () => pm.response.to.have.status(201));",
                      "pm.environment.set('customerId', pm.response.json().id);"
